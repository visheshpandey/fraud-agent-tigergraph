// =============================================================================
// FraudGraph — core schema
// =============================================================================
// Run with:  gsql -f schema/01_schema.gsql   (or a pyTigerGraph conn.gsql() call)
//
// Follows the "Suggested graph schema" in data/raw/README.md (vertex/edge names:
// Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion,
// ClosedCase, OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT, INVOLVES,
// ON_CARD, CONNECTED_TO) plus our own extensions: RECIPIENT_EMAIL (R_emaildomain,
// the suggestion only covers the purchaser side), InvestigationCase + its edges (the agent's
// own investigation record — reuses INVOLVES/ON_CARD/CONNECTED_TO via multi-pair
// edge definitions so InvestigationCase and ClosedCase are queried identically), SIMILAR_TO
// (case-memory retrieval, made explicit as a graph edge rather than left implicit
// in a JSON field), and DocChunk (policy/regulatory/pattern text for GraphRAG).
//
// V1-V339, C1-C14, D1-D15, M1-M9 are NOT modeled as vertex attributes: 339+ unnamed
// engineered columns per transaction would bloat the vertex for no graph-structural
// benefit. They are used as pandas-side signals in src/prep/ (e.g. velocity,
// amount-anomaly scoring) and cited as `source: "graph"` evidence by column name
// when they inform a claim, per the README's "say so in your evidence" instruction.
// =============================================================================

DROP ALL

// ----------------------------------------------------------------------------
// Entity vertices — the fraud network
// ----------------------------------------------------------------------------

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING   // e.g. "C01234"
) WITH primary_id_as_attribute="true"

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,      // e.g. "C01234-K1" — customer_id + card suffix
  card1  INT,
  card2  INT,
  card3  INT,
  card4  STRING,                  // network: visa / mastercard / american express / discover
  card5  INT,
  card6  STRING                   // type: credit / debit
) WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (
  PRIMARY_ID transaction_id STRING,   // TransactionID
  transaction_dt INT,                 // raw TransactionDT (seconds from dataset start)
  ts             DATETIME,            // real timestamp, added column
  amount         DOUBLE,              // TransactionAmt
  product_cd     STRING,              // W/C/H/R/S — W has no identity record
  channel        STRING,              // in_person | online
  risk_score     DOUBLE,              // bank model score, 0-1 — an input, never a verdict
  addr1          INT,
  addr2          INT,
  dist1          INT,
  dist2          INT,
  p_emaildomain  STRING,
  r_emaildomain  STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_id STRING,    // derived: hash of device_info + os + browser + screen
  device_info STRING,             // DeviceInfo, e.g. "SAMSUNG SM-G935F Build/NRD90M"
  device_type STRING,             // DeviceType: mobile | desktop
  os          STRING,             // id_30
  browser     STRING,             // id_31
  screen_res  STRING,             // id_33
  proxy_flag  STRING,             // id_23: transparent | anonymous | hidden | ""
  is_new      BOOL                // id_15 == "New" for this account
) WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_id STRING,    // stringified addr1
  addr1 INT,
  addr2 INT                       // country code; 87 is the home country
) WITH primary_id_as_attribute="true"

// ----------------------------------------------------------------------------
// InvestigationCase memory — closed_cases_history.csv, loaded as-is (July-October, the only
// place the ground truth lives) and never written to by the agent.
// ----------------------------------------------------------------------------

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,          // e.g. "CC-0141"
  customer_id        STRING,
  card_id            STRING,
  opened_at          DATETIME,
  closed_at          DATETIME,
  outcome            STRING,          // confirmed_fraud | cleared
  pattern            STRING,          // one of the 7 pattern values, or "none" if cleared
  first_fraud_txn_id STRING,
  txn_ids            SET<STRING>,
  n_txns             INT,
  exposure_usd       DOUBLE,
  connected_card_ids SET<STRING>,
  actions_taken      STRING,
  report_filed       BOOL,
  analyst_notes      STRING
) WITH primary_id_as_attribute="true"

// ----------------------------------------------------------------------------
// InvestigationCase — the agent's OWN investigation record. Fields mirror the README's
// Answer Format ("case" object) near-verbatim so Phase 6 can read this vertex
// straight into the graded JSON instead of reconstructing it from scratch.
// next_best_actions and sar are flattened with a prefix since GSQL vertices
// don't nest; JSON-serializable list fields (evidence, actions) are stored as
// STRING (JSON-encoded) since their item shape (action/route/reason etc.) is
// richer than a flat SET can hold.
// ----------------------------------------------------------------------------

CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,              // matches the HHG-### case_id from case_pack.csv
  status                STRING,           // open | closed_fraud | closed_legitimate | escalated
  verdict               STRING,           // fraud | legitimate | uncertain
  fraud_probability     DOUBLE,
  pattern               STRING,
  pattern_description   STRING,
  affected_txn_ids      SET<STRING>,
  first_suspicious_txn_id STRING,
  connected_card_ids    SET<STRING>,
  connected_device_profiles SET<STRING>,
  exposure_usd          DOUBLE,
  evidence_json         STRING,          // JSON list of {claim, source, ref, entity_ids}
  similar_prior_cases   SET<STRING>,     // ClosedCase ids retrieved as memory
  summary               STRING,
  evidence_requests_json STRING,         // JSON list of {type, asked_after_step, assumed_response}
  initial_actions_json  STRING,          // JSON list of {action, route, reason}
  final_actions_json    STRING,
  what_changed          STRING,
  stop_reason           STRING,
  sar_file              BOOL,
  sar_reason            STRING,
  sar_narrative         STRING,
  sar_subjects          SET<STRING>,
  sar_total_amount_usd  DOUBLE,
  sar_first_date        DATETIME,
  sar_last_date         DATETIME,
  trigger_type          STRING,          // risk_score | customer_report | analyst_request
  trigger_text          STRING,
  opened_at             DATETIME,
  closed_at             DATETIME
) WITH primary_id_as_attribute="true"

// Policy, typologies, regulatory references, and closed-case narratives, chunked
// for retrieval — this is what makes evidence GraphRAG rather than a raw dump.
CREATE VERTEX DocChunk (
  PRIMARY_ID chunk_id STRING,
  doc_name STRING,
  doc_type STRING,      // policy | typology | regulation | pattern | case_narrative
  section  STRING,
  text     STRING,
  ordinal  INT
) WITH primary_id_as_attribute="true"

// ----------------------------------------------------------------------------
// Structural edges — UNDIRECTED so the agent can traverse either way cheaply
// (e.g. a DeviceProfile must reach its Transactions as easily as the reverse)
// ----------------------------------------------------------------------------

CREATE UNDIRECTED EDGE OWNS            (FROM Customer,    TO Card)
CREATE UNDIRECTED EDGE MADE            (FROM Card,        TO Transaction)
CREATE UNDIRECTED EDGE FROM_DEVICE     (FROM Transaction, TO DeviceProfile)   // online only
CREATE UNDIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE UNDIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain)    // our extension: R_emaildomain
CREATE UNDIRECTED EDGE BILLED_IN       (FROM Transaction, TO BillingRegion)

// Temporal chain per card, ordered by ts. Direction is meaningful, so directed.
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction,
                           gap_seconds INT) WITH REVERSE_EDGE="PREV"

// ----------------------------------------------------------------------------
// InvestigationCase edges — declared with two FROM/TO pairs so ClosedCase and InvestigationCase are
// queried identically; a fresh InvestigationCase becomes case memory the moment it's written,
// with no separate query path needed for "cases we investigated" vs "cases the
// bank already closed".
// ----------------------------------------------------------------------------

CREATE DIRECTED EDGE INVOLVES (
  FROM ClosedCase, TO Transaction | FROM InvestigationCase, TO Transaction
) WITH REVERSE_EDGE="INVOLVED_IN_CASE"

CREATE DIRECTED EDGE ON_CARD (
  FROM ClosedCase, TO Card | FROM InvestigationCase, TO Card
) WITH REVERSE_EDGE="CASE_ON_CARD"

CREATE DIRECTED EDGE CONNECTED_TO (
  FROM ClosedCase, TO Card | FROM InvestigationCase, TO Card
) WITH REVERSE_EDGE="CASE_CONNECTED_FROM"

CREATE DIRECTED EDGE INVOLVES_CUSTOMER (
  FROM ClosedCase, TO Customer | FROM InvestigationCase, TO Customer
) WITH REVERSE_EDGE="CUSTOMER_IN_CASE"

// InvestigationCase memory as a graph edge, not just a JSON field — populated from
// InvestigationCase.emb / ClosedCase.emb vector search once a similar prior case is retrieved.
CREATE DIRECTED EDGE SIMILAR_TO (FROM InvestigationCase, TO ClosedCase,
                                 similarity DOUBLE) WITH REVERSE_EDGE="SIMILAR_FROM"

// ----------------------------------------------------------------------------

CREATE GRAPH FraudGraph (
  Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion,
  ClosedCase, InvestigationCase, DocChunk,
  OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, RECIPIENT_EMAIL, BILLED_IN, NEXT,
  INVOLVES, ON_CARD, CONNECTED_TO, INVOLVES_CUSTOMER, SIMILAR_TO
)
