// Device-based ring signal, seeded from ONE specific transaction rather than
// a card's entire history. Originally seeded from all of a card's
// transactions -> all devices it has EVER used -> every card sharing any of
// those -- which for a long-lived, high-activity customer pulled in their
// entire multi-year device history and surfaced dozens of "confirmed fraud"
// cards purely by statistical chance (a device shared once, years apart, is
// not a ring). Seeding from the single flagged transaction's device instead
// answers the actually relevant question: who else used THIS device around
// THIS event.
USE GRAPH FraudGraph

CREATE QUERY fraud_ring_component(STRING seed_txn_id) FOR GRAPH FraudGraph {
  SetAccum<STRING> @@connected_card_ids;
  SetAccum<STRING> @@connected_customer_ids;
  SetAccum<STRING> @@known_fraud_card_ids;

  Seed = {Transaction.*};
  Seed = SELECT t FROM Seed:t WHERE t.transaction_id == seed_txn_id;

  SeedCard = SELECT c FROM Seed:t -(MADE:e)- Card:c;
  SetAccum<STRING> @@seed_card_id;
  SeedCard = SELECT c FROM SeedCard:c ACCUM @@seed_card_id += c.card_id;

  Devices = SELECT d FROM Seed:t -(FROM_DEVICE:e)- DeviceProfile:d;

  OtherTxns = SELECT t FROM Devices:d -(FROM_DEVICE:e)- Transaction:t;

  OtherCards = SELECT c FROM OtherTxns:t -(MADE:e)- Card:c
               WHERE c.card_id NOT IN @@seed_card_id
               ACCUM @@connected_card_ids += c.card_id
               LIMIT 100;

  OtherCustomers = SELECT cu FROM OtherCards:c -(OWNS:e)- Customer:cu
                   ACCUM @@connected_customer_ids += cu.customer_id;

  FraudLinks = SELECT cc FROM OtherCards:c -(CASE_ON_CARD:e)- ClosedCase:cc
               WHERE cc.outcome == "confirmed_fraud"
               ACCUM @@known_fraud_card_ids += c.card_id;

  PRINT @@connected_card_ids, @@connected_customer_ids, @@known_fraud_card_ids;
}

INSTALL QUERY fraud_ring_component
