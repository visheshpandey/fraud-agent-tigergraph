// Two-hop traversal from a seed card, through the devices it's used, out to
// every other card sharing one of those devices — a deliberately simple
// device-based ring signal (kept to a fixed 2 hops rather than an open-ended
// BFS/WHILE loop, which is harder to get right blind and to bound at query
// time). Cross-references ClosedCase via the CASE_ON_CARD reverse edge to
// flag which connected cards already have confirmed-fraud history.
USE GRAPH FraudGraph

CREATE QUERY fraud_ring_component(STRING seed_card_id) FOR GRAPH FraudGraph {
  SetAccum<STRING> @@connected_card_ids;
  SetAccum<STRING> @@connected_customer_ids;
  SetAccum<STRING> @@known_fraud_card_ids;

  Seed = {Card.*};
  Seed = SELECT c FROM Seed:c WHERE c.card_id == seed_card_id;

  SeedTxns = SELECT t FROM Seed:c -(MADE:e)- Transaction:t;

  Devices = SELECT d FROM SeedTxns:t -(FROM_DEVICE:e)- DeviceProfile:d;

  OtherTxns = SELECT t FROM Devices:d -(FROM_DEVICE:e)- Transaction:t;

  OtherCards = SELECT c FROM OtherTxns:t -(MADE:e)- Card:c
               WHERE c.card_id != seed_card_id
               ACCUM @@connected_card_ids += c.card_id
               LIMIT 100;

  OtherCustomers = SELECT cu FROM OtherCards:c -(OWNS:e)- Customer:cu
                   ACCUM @@connected_customer_ids += cu.customer_id;

  FraudLinks = SELECT cc FROM OtherCards:c -(CASE_ON_CARD:e)- ClosedCase:cc
               WHERE cc.outcome == "confirmed_fraud"
               ACCUM @@known_fraud_card_ids += c.card_id;

  PRINT @@connected_card_ids, @@connected_customer_ids, @@known_fraud_card_ids;
}

INSTALL QUERY fraud_ring_component
