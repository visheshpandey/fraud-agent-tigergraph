// GraphRAG grounding: vectorSearch over DocChunk.emb (policy text, the 5
// documented fraud patterns, regulatory references). This is what keeps the
// agent's reasoning tied to actual policy language instead of the LLM's own
// unstated assumptions about what a bank "should" do.
USE GRAPH FraudGraph

CREATE QUERY policy_search(LIST<FLOAT> query_vector, INT k=5) FOR GRAPH FraudGraph SYNTAX v3 {
  MapAccum<VERTEX, FLOAT> @@distances;
  Results = vectorSearch({DocChunk.emb}, query_vector, k, {distance_map: @@distances});
  PRINT Results WITH VECTOR;
  PRINT @@distances;
}

INSTALL QUERY policy_search
